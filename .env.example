# ============ Bot API（必填）============
# 从 @BotFather 获取
BOT_TOKEN=1234567890:replace-me

# ============ MTProto 用户账号（必填）============
# 从 https://my.telegram.org → API development tools 申请
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef

# 登录方式：auto（默认，优先终端扫码）/ qr（强制扫码）/ phone（验证码）
LOGIN_MODE=auto

# 用户账号手机号（E.164 格式）；仅 LOGIN_MODE=phone 必填，auto 下作回退用
TG_PHONE=+8613800000000

# ============ 权限（可选，仅首次启动迁移用）============
# 旧版环境变量白名单：仅当业务数据库 users 表为空时导入为启用用户，
# 此后白名单以数据库为准（用户经 Bot /start 申请，管理员审批）。
# 留空 = 跳过导入；空库时 Bot 对链接请求按未授权处理
ALLOWED_USER_IDS=

# ============ 可选项（默认值见注释）============
# 本地 Bot API 服务器地址（官方 telegram-bot-api --local 模式；备选路线，应急
# 切换见 docs/guide/deployment.md §5，Docker 部署需同时启用 compose 的 bigfile profile）。
# 配置后全部上传走该服务器，不再使用 MTProto 直传；上限同为 2000MB。
# 留空 = 使用 Telegram 官方服务器；超过 50MB 的媒体自动经 Bot 号 MTProto 直传
BOT_API_URL=

# worker 并发数，默认 1；可在 Web 运行设置按数据库覆盖（1–16，重启生效）
WORKER_COUNT=1
# 缓存频道（重复链接复用）：新建一个私有频道、把 bot 设为管理员后填入频道
# 数字 ID（-100 前缀）。任务成功投递会同步写无脚注干净副本，同链接再次
# 提交（任何人）直接整条复制秒回（不限媒体大小、相册保组）。留空 = 关闭
DUMP_CHANNEL_ID=
# 数据目录（session.json / peers.json），默认 data
DATA_DIR=data
# 临时媒体目录，默认 <DATA_DIR>/tmp
TEMP_DIR=
# 发送大小上限（字节），默认 2097152000（2000MB，MTProto 上传硬上限）
MAX_FILE_SIZE=
# 流式下载上限（字节），超过则走内存管道缓冲，默认 20971520（20MB）
STREAM_LIMIT=
# 内存重排序缓冲上限（字节）：STREAM_LIMIT–该值区间的文件多线程并行下载到
# 内存、上传边读边发（下载与上传重叠、零磁盘写入）；超过该值回落临时文件
# 多线程落盘。单文件常驻 RAM 上限，默认 536870912（512MB），
# 需介于 STREAM_LIMIT 与 MAX_FILE_SIZE 之间
IN_MEMORY_LIMIT=
# 内存管道进程级预算（字节）：所有并发的内存管道下载共享的常驻 RAM 总额度，
# 预算不足的文件自动降级临时文件路径（边下边传），使内存被额度封顶而不随
# 并发任务数（WORKER_COUNT、相册成员数）线性放大。默认 1073741824（1GB），
# 可调 64MB–8GB；管理端「运行设置」的 memory_budget 键可热调（即时生效，
# 只影响新打开的媒体，在途传输自然回收）
MEMORY_BUDGET=
# 并行下载分片线程数（1–16），默认 4；设 1 回退单线程（流式小文件路径固定单流）
DOWNLOAD_THREADS=4
# MTProto 大文件上传并发分片线程数（1–16），默认 4；设 1 回退单线程
UPLOAD_THREADS=4
# 下载侧 MTProto 连接池上限（1–16），默认 4：并发分片线程默认复用单条 TCP
# 连接（单连接吞吐典型 15–30MB/s），池让它们各走独立连接，带宽富余的机器
# 上大文件吞吐可提升数倍；设 1 回退单连接现状。一般不超过 DOWNLOAD_THREADS
DOWNLOAD_CONNECTIONS=4
# 上传侧（Bot 会话）MTProto 连接池上限（1–16），默认 4，语义同上；设 1 回退
UPLOAD_CONNECTIONS=4
# 临时媒体目录总量上限（字节），超过则拒绝落盘下载，默认 5368709120（5GB）
TEMP_DIR_MAX_SIZE=
# 视频封面兜底抽帧的 ffmpeg 可执行路径，默认按 PATH 查找 ffmpeg。
# 重发视频优先携带源消息自带的缩略图；源无缩略图时用 ffmpeg 从视频头部
# 抽首帧作为封面。ffmpeg 未安装或抽帧失败时自动降级为无封面发送
FFMPEG_PATH=
# 日志级别 debug/info/warn/error，默认 info
LOG_LEVEL=info

# ============ Web 管理端 ============
# Compose 部署时由 docker-compose.yml 在容器内覆盖为 0.0.0.0:8080，
# 宿主端口只绑定 127.0.0.1:8080，公网入口由宿主机反向代理终止 TLS。
# 管理端域名不进本文件：它只出现在宿主机反向代理配置与 DNS 记录中。
WEB_ADDR=127.0.0.1:8080

# GitHub OAuth 登录通道（可选）：OAuth App 的 client id/secret，
# 必须成对配置；留空则登录页只显示访问密钥通道。
# 绑定操作在登录后的「设置 → GitHub 登录」页面完成；申请与配置详见 docs/guide/github-oauth.md
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Web 修改 GitHub Secret 时使用的独立 AES-256-GCM 主密钥（32 字节原文/hex/base64）；不入库、不进备份
WEB_OAUTH_ENCRYPTION_KEY=

# 是否信任反向代理转发头（X-Forwarded-For / X-Forwarded-Proto）：
# 仅用于审计来源 IP 与回调地址推导；应用直接暴露时保持 false，默认 false
WEB_TRUSTED_PROXY=false

# ============ 事件与通知 ============
# 同一事件两次 Telegram 管理员通知的最小间隔（分钟），默认 30。
# 通知发往 users 表中 owner 用户的私聊（管理端「设为 owner」），无单独环境变量
NOTIFY_COOLDOWN_MIN=30
# Bot API 连续发送失败多少次后产生事件，默认 3
EVENT_BOT_FAIL_THRESHOLD=3
# 任务连续失败多少次后产生事件（成功即清零），默认 5
EVENT_TASK_FAIL_THRESHOLD=5
# 临时媒体目录占用告警阈值（GB，支持小数），默认 1；回落到阈值以下自动解决
EVENT_DISK_LIMIT_GB=1

# ============ 云盘下载（可选）============
# /download 指令（媒体上传网盘）使用的 rclone 二进制路径。
# 留空 = 使用 PATH 中的 rclone：Docker 镜像已内置固定版本，无需配置；
# 本地开发先安装（macOS：brew install rclone）后仍可留空，
# 仅当二进制不在 PATH 或需要指定版本时填写绝对路径（如 /opt/homebrew/bin/rclone）。
# 网盘目的地与开关在管理端「云盘下载」页配置（data/cloud-drive.json），见 docs/ops/operations.md
RCLONE_BIN=
